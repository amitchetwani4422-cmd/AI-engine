# =============================================================================
# AI CONTENT ENGINE — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your actual values.
# Never commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# FAL.AI — Video Generation (Kling 3.0 and Veo 3.1)
# Get your key at: https://fal.ai/dashboard/keys
# -----------------------------------------------------------------------------
FAL_API_KEY=fal_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# ANTHROPIC — Claude (Script generation, idea scoring, content planning)
# Get your key at: https://console.anthropic.com/
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OPENAI — GPT-4o / GPT-4o mini (alternative to Claude for ideas & scripts)
# Get your key at: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# ELEVENLABS — Voice generation and cloning
# Get your key at: https://elevenlabs.io/app/settings/api-keys
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# SUNO — Music generation
# Get your key at: https://suno.com/account
# -----------------------------------------------------------------------------
SUNO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# GOOGLE / YOUTUBE — OAuth and channel management
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Scopes required: https://www.googleapis.com/auth/youtube.upload,
#                  https://www.googleapis.com/auth/youtube
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# META / INSTAGRAM — Graph API for Instagram Business publishing
# Create an app at: https://developers.facebook.com/
# Requires: instagram_basic, instagram_content_publish, pages_read_engagement
# -----------------------------------------------------------------------------
META_APP_ID=000000000000000
META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_ACCESS_TOKEN=IGQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_BUSINESS_ACCOUNT_ID=000000000000000

# -----------------------------------------------------------------------------
# CLOUDINARY — Media storage, transformations, and CDN
# Find values at: https://console.cloudinary.com/settings/api-keys
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL (Neon or Supabase recommended)
# Neon:    https://neon.tech/
# Supabase: https://supabase.com/
# Format:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/ai_content_engine?sslmode=require

# -----------------------------------------------------------------------------
# REDIS — Upstash Redis (job queuing, caching, rate limiting)
# Get your URL at: https://console.upstash.com/
# -----------------------------------------------------------------------------
REDIS_URL=rediss://default:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@example-redis.upstash.io:6379

# -----------------------------------------------------------------------------
# STORAGE — Google Cloud Storage bucket for raw video assets
# -----------------------------------------------------------------------------
STORAGE_BUCKET=ai-content-engine-assets

# -----------------------------------------------------------------------------
# ANALYTICS DB — Separate analytics database URL (optional, can be same as DATABASE_URL)
# -----------------------------------------------------------------------------
ANALYTICS_DB_URL=postgresql://user:password@ep-analytics-123456.us-east-2.aws.neon.tech/ai_content_analytics?sslmode=require

# -----------------------------------------------------------------------------
# NEXTAUTH — Authentication
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=your-super-secret-nextauth-secret-change-this-in-production
NEXTAUTH_URL=http://localhost:3000
